# ============================================================
# LoRA Fine-Tuning: Receipt/Invoice Field Extraction
# Model: Qwen2.5-0.5B-Instruct + PEFT/LoRA
# Run on Kaggle Notebook (free T4 GPU) or Google Colab
# ============================================================

import os
os.environ["CUDA_VISIBLE_DEVICES"] = "0"  # force single GPU -- Kaggle's T4x2
# triggers DataParallel otherwise, which crashes with PEFT (device mismatch)

# ---- 1. Install deps (run once) ----
# !pip install -q transformers peft trl datasets accelerate bitsandbytes
# !pip uninstall -y torchao -q
# ^ Kaggle ships an old torchao that breaks peft's LoRA dispatch with an
#   ImportError. We don't need torchao for basic LoRA, so remove it.
#   RESTART THE KERNEL after running this line, then run the rest of the script.

import torch
from datasets import load_dataset
from transformers import AutoModelForCausalLM, AutoTokenizer
from peft import LoraConfig, get_peft_model, TaskType
from trl import SFTTrainer, SFTConfig
import json
import re
import ast

MODEL_NAME = "Qwen/Qwen2.5-0.5B-Instruct"
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
print(f"Using device: {DEVICE}")

tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)  # loaded early -- needed for apply_chat_template below

# ---- 2. Load dataset ----
# mychen76/invoices-and-receipts_ocr_v1: each row has 'image', 'id',
# 'parsed_data' (ground-truth structured JSON), 'raw_data' (OCR JSON:
# ocr_words + ocr_boxes + ocr_labels). We only want ocr_words (plain text)
# as input, and a few fields from parsed_data as the target.
dataset = load_dataset("mychen76/invoices-and-receipts_ocr_v1")
dataset = dataset.remove_columns(["image"])  # heavy, not needed for this task
print(dataset)
print(dataset["train"][0]["parsed_data"])  # sanity check field names

MAX_OCR_WORDS = 120  # cap input length so sequences stay small -> no OOM

def format_example(example):
    # --- input: plain OCR words only, NOT the boxes/coords ---
    try:
        raw = json.loads(example["raw_data"])
        words_field = raw["ocr_words"]
        ocr_words = ast.literal_eval(words_field) if isinstance(words_field, str) else words_field
    except Exception:
        ocr_words = []
    ocr_text = " ".join(ocr_words[:MAX_OCR_WORDS])

    # --- target: pull real fields out of parsed_data ---
    try:
        parsed = json.loads(example["parsed_data"])
        inner = ast.literal_eval(parsed["json"])  # inner is python-dict-repr, not valid JSON
        header = inner.get("header", {})
        summary = inner.get("summary", {})
        target_fields = {
            "vendor": header.get("seller", ""),
            "date": header.get("invoice_date", ""),
            "total": summary.get("total_gross_worth", ""),
        }
    except Exception:
        target_fields = {"vendor": "", "date": "", "total": ""}

    prompt_text = (
        "Extract the vendor, date, and total from this OCR receipt text. "
        "Respond ONLY with JSON.\n\n"
        f"OCR TEXT:\n{ocr_text}\n\nJSON:"
    )
    completion_text = json.dumps(target_fields)

    # NOTE: use the tokenizer's own chat template instead of a hand-rolled
    # ChatML string. Hand-rolled special-token strings can be mis-tokenized
    # (split into ordinary subwords instead of recognized as single special
    # tokens), which feeds the model a context it was never trained to
    # parse -- this was the actual cause of degenerate/looping generations,
    # not the LoRA training itself.
    prompt = tokenizer.apply_chat_template(
        [{"role": "user", "content": prompt_text}],
        tokenize=False,
        add_generation_prompt=True,
    )
    completion_text = json.dumps(target_fields)

    return {
        "prompt": prompt,
        "completion": f"{completion_text}{tokenizer.eos_token}",
    }

train_data = dataset["train"].map(format_example)
# drop any rows where target extraction failed (empty vendor+date+total)
train_data = train_data.filter(lambda ex: json.loads(ex["completion"].replace(tokenizer.eos_token, "")).get("vendor", "") != "")
print(f"Training rows after filtering: {len(train_data)}")

# Hold out a small eval slice for baseline + after comparison
eval_data = train_data.select(range(min(30, len(train_data))))
train_data = train_data.select(range(30, len(train_data)))

# ---- 4. Load model ----
# NOTE: using float32, not float16. Small Qwen models can produce garbled,
# seemingly-random multilingual output under fp16 due to overflow in certain
# layers -- this model is small enough (0.5B) that fp32 comfortably fits in
# GPU memory, and it removes numerical instability as a variable entirely.
model = AutoModelForCausalLM.from_pretrained(
    MODEL_NAME, dtype=torch.float32, attn_implementation="eager"
).to(DEVICE)

# ---- 5. Baseline eval (BEFORE fine-tuning) ----
def extract_json(text):
    match = re.search(r"\{.*\}", text, re.DOTALL)
    if not match:
        return {}
    try:
        return json.loads(match.group(0))
    except Exception:
        return {}

def run_eval(model, eval_examples, label=""):
    correct_fields = 0
    total_fields = 0
    for ex in eval_examples:
        inputs = tokenizer(ex["prompt"], return_tensors="pt", truncation=True, max_length=400).to(DEVICE)
        with torch.no_grad():
            out = model.generate(
                **inputs,
                max_new_tokens=100,
                do_sample=False,
                use_cache=False,
                pad_token_id=tokenizer.eos_token_id,
            )
        decoded = tokenizer.decode(out[0], skip_special_tokens=True)
        pred = extract_json(decoded)
        gold = extract_json(ex["completion"])
        for k in gold:
            total_fields += 1
            if str(pred.get(k, "")).strip().lower() == str(gold[k]).strip().lower():
                correct_fields += 1
        del inputs, out
        torch.cuda.empty_cache()
    acc = correct_fields / max(total_fields, 1)
    print(f"[{label}] Field-level exact-match accuracy: {acc:.2%}")
    return acc

print("Running BASELINE eval (before fine-tuning)...")
baseline_acc = run_eval(model, eval_data, label="BASELINE")

# ---- 6. Apply LoRA ----
lora_config = LoraConfig(
    task_type=TaskType.CAUSAL_LM,
    r=8,
    lora_alpha=16,
    lora_dropout=0.05,
    target_modules=["q_proj", "v_proj"],  # attention projections
)
model = get_peft_model(model, lora_config)
model.print_trainable_parameters()  # sanity check: should be a tiny % of total params

# ---- 7. Train ----
training_args = SFTConfig(
    output_dir="./lora-receipt-extract",
    per_device_train_batch_size=4,
    gradient_accumulation_steps=4,
    num_train_epochs=3,
    learning_rate=2e-5,
    warmup_ratio=0.1,
    max_grad_norm=0.3,
    lr_scheduler_type="cosine",
    fp16=False,  # model is fp32 now -- see note above
    logging_steps=10,
    save_strategy="epoch",
    report_to="none",
    # no dataset_text_field -- dataset has prompt/completion columns,
    # which TRL detects automatically and uses to mask loss to completion-only
)

trainer = SFTTrainer(
    model=model,
    args=training_args,
    train_dataset=train_data,
)

trainer.train()

# ---- 8. Eval AFTER fine-tuning ----
print("Running eval AFTER fine-tuning...")
finetuned_acc = run_eval(model, eval_data, label="FINE-TUNED")

print(f"\n=== RESULTS ===")
print(f"Baseline accuracy:    {baseline_acc:.2%}")
print(f"Fine-tuned accuracy:  {finetuned_acc:.2%}")
print(f"Improvement:          {(finetuned_acc - baseline_acc):.2%}")

# ---- 9. Save adapter + push to GitHub after ----
model.save_pretrained("./lora-receipt-extract-final")
tokenizer.save_pretrained("./lora-receipt-extract-final")
print("Saved. Now: git init, commit, push to GitHub, write README with these numbers.")


# ---- Diagnostic v4 ----
# Paste into a new cell (model/tokenizer/eval_data already in memory, no retrain needed)

for i, ex in enumerate(eval_data.select(range(5))):
    inputs = tokenizer(ex["prompt"], return_tensors="pt", truncation=True, max_length=400).to(DEVICE)
    with torch.no_grad():
        out = model.generate(
            **inputs,
            max_new_tokens=100,
            do_sample=False,
            repetition_penalty=1.3,
            no_repeat_ngram_size=3,
            pad_token_id=tokenizer.eos_token_id,
        )
    full_decoded = tokenizer.decode(out[0], skip_special_tokens=False)
    prompt_decoded = tokenizer.decode(inputs["input_ids"][0], skip_special_tokens=False)
    generated_only = full_decoded[len(prompt_decoded):]

    print(f"--- Example {i} ---")
    print("PROMPT (first 300 chars):", ex["prompt"][:300])
    print("GOLD:      ", ex["completion"])
    print("GENERATED: ", generated_only)
    print()


